{
  "name": "signal-lynx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "postbuild": "node scripts/vercel-postbuild-trim.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "npm run check -- --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/client-sesv2": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@opentelemetry/api": "^1.9.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "cookie": "^1.1.1",
    "fuse.js": "^7.4.2",
    "handlebars": "^4.7.9",
    "stripe": "^22.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.21",
    "daisyui": "^5.5.23",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "cookie": "^1.1.1",
    "devalue": "^5.8.1",
    "tar": "^7.5.15",
    "fast-xml-parser": "5.7.3",
    "fast-xml-builder": "1.2.0",
    "flatted": "3.4.2",
    "qs": "^6.15.1",
    "minimatch": "^10.2.5",
    "@sveltejs/adapter-vercel": {
      "esbuild": "0.28.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
