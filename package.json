{
  "name": "signal-lynx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "postbuild": "node scripts/vercel-postbuild-trim.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "npm run check -- --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/client-sesv2": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@opentelemetry/api": "^1.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "cookie": "^1.1.1",
    "fuse.js": "^7.5.0",
    "handlebars": "^4.7.9",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "daisyui": "^5.7.46",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "cookie": "^1.1.1",
    "devalue": "^5.9.2",
    "tar": "^7.5.22",
    "fast-xml-parser": "5.11.1",
    "fast-xml-builder": "1.3.1",
    "flatted": "3.4.4",
    "qs": "^6.16.0",
    "minimatch": "^10.2.6",
    "nanoid": "3.3.19",
    "@sveltejs/adapter-vercel": {
      "esbuild": "0.28.2"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
