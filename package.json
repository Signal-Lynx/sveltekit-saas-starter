{
  "name": "signal-lynx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "postbuild": "node scripts/vercel-postbuild-trim.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "npm run check -- --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "check:runtime": "node scripts/check-runtime-deps.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-sesv2": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@opentelemetry/api": "^1.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "cookie": "^2.0.1",
    "fuse.js": "^7.5.0",
    "handlebars": "^4.7.10",
    "stripe": "23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-vercel": "^7.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "daisyui": "^5.7.50",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "devalue": "^5.9.2",
    "tar": "^7.5.22",
    "fast-xml-parser": "5.11.1",
    "fast-xml-builder": "1.3.1",
    "flatted": "3.4.4",
    "qs": "^6.16.0",
    "minimatch": "^10.2.6",
    "nanoid": "3.3.19",
    "@sveltejs/adapter-vercel": {
      "esbuild": "0.28.2"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
